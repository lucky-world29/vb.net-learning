<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request of Transport Order Management - 16:9 Layout</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html, body {
                height: 100vh;
                width: 100vw;
                overflow: hidden;
                font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                font-size: 12px;
                background: #f0f2f5;
            }

            .rot-shell {
                display: flex;
                flex-direction: column;
                height: 100vh;
                width: 100vw;
            }

            /* ── HEADER ───────────────────────────────────────────────────────────── */
            .main-header {
                flex: 0 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 6px 12px;
                background: linear-gradient(135deg, #1a73e8 0%, #1557b0 100%);
                color: white;
                box-shadow: 0 2px 8px rgba(0,0,0,.12);
            }

                .main-header h1 {
                    margin: 0;
                    font-size: 15px;
                    font-weight: 700;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

            .header-info {
                display: flex;
                gap: 16px;
                font-size: 10px;
                font-weight: 500;
            }

                .header-info div {
                    display: flex;
                    align-items: center;
                    gap: 4px;
                }

            /* ── MAIN CONTENT AREA ────────────────────────────────────────────────── */
            .rot-content {
                flex: 1 1 0;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 5px;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

                .rot-content::-webkit-scrollbar {
                    width: 5px;
                }

                .rot-content::-webkit-scrollbar-track {
                    background: #e8eaed;
                }

                .rot-content::-webkit-scrollbar-thumb {
                    background: #9aa0a6;
                    border-radius: 3px;
                }

                    .rot-content::-webkit-scrollbar-thumb:hover {
                        background: #5f6368;
                    }

            /* ── SECTION BLOCKS ───────────────────────────────────────────────────── */
            .section-block {
                background: #fff;
                border: 1px solid #dadce0;
                border-radius: 4px;
                overflow: hidden;
                flex-shrink: 0;
                box-shadow: 0 1px 3px rgba(0,0,0,.08);
            }

            .section-title {
                padding: 6px 10px;
                background: linear-gradient(135deg, #1a73e8 0%, #1557b0 100%);
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 6px;
                letter-spacing: 0.3px;
            }

            .section-body {
                padding: 6px 8px;
            }

            /* ── FORM ROWS & GROUPS ───────────────────────────────────────────────── */
            .form-row {
                display: flex;
                flex-wrap: wrap;
                gap: 2px;
                margin-bottom: 2px;
            }

            .form-group {
                flex: 1;
                min-width: 140px;
                display: flex;
                align-items: center;
                gap: 3px;
            }

                .form-group.full-width {
                    flex: 0 0 100%;
                    flex-direction: column;
                    gap: 2px;
                }

                .form-group label {
                    font-size: 10px;
                    font-weight: 600;
                    color: #202124;
                    white-space: nowrap;
                    flex-shrink: 0;
                    min-width: fit-content;
                    max-width: 45%;
                }

                .form-group.full-width label {
                    max-width: none;
                }

            .required-star {
                color: #d32f2f;
                font-weight: 700;
            }

            .form-control, .form-select {
                width: 100%;
                padding: 3px 5px;
                font-size: 10px;
                border: 1px solid #dadce0;
                border-radius: 3px;
                background: #fff;
                height: 24px;
                color: #202124;
                font-family: 'Roboto', inherit;
                flex: 1;
            }

            .form-group.full-width .form-control,
            .form-group.full-width .form-select {
                flex: none;
            }

            .form-control:focus, .form-select:focus {
                outline: none;
                border-color: #1a73e8;
                box-shadow: 0 0 0 2px rgba(26,115,232,.15);
            }

            .form-control[readonly] {
                background: #f8f9fa;
                color: #5f6368;
            }

            textarea.form-control {
                height: auto;
                resize: none;
                padding: 3px 5px;
                min-height: 32px;
                max-height: 50px;
                font-family: 'Roboto', inherit;
            }

            select[multiple].form-control {
                height: 50px;
            }

            /* ── BUTTONS ──────────────────────────────────────────────────────────── */
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 3px;
                padding: 3px 8px;
                font-size: 9px;
                font-weight: 600;
                border-radius: 3px;
                border: 1px solid transparent;
                cursor: pointer;
                transition: all .2s;
                white-space: nowrap;
                background: #f8f9fa;
                color: #202124;
                font-family: 'Roboto', inherit;
            }

                .btn:hover {
                    background: #f0f2f5;
                    box-shadow: 0 1px 3px rgba(0,0,0,.12);
                }

            .btn-primary {
                background: #1a73e8;
                color: #fff;
                border-color: #1a73e8;
            }

                .btn-primary:hover {
                    background: #1557b0;
                }

            .btn-success {
                background: #34a853;
                color: #fff;
                border-color: #34a853;
            }

                .btn-success:hover {
                    background: #2d8e47;
                }

            .btn-outline-primary {
                background: #fff;
                color: #1a73e8;
                border-color: #1a73e8;
            }

                .btn-outline-primary:hover {
                    background: #f8f9fa;
                }

            .btn-outline-secondary {
                background: #fff;
                color: #5f6368;
                border-color: #dadce0;
            }

                .btn-outline-secondary:hover {
                    background: #f8f9fa;
                }

            .btn-light {
                background: #fff;
                color: #1a73e8;
                border-color: #dadce0;
            }

                .btn-light:hover {
                    background: #f8f9fa;
                }

            .btn-group {
                display: flex;
                gap: 0;
                width: 100%;
            }

                .btn-group .btn {
                    flex: 1;
                    border-radius: 0;
                }

                    .btn-group .btn:first-child {
                        border-radius: 3px 0 0 3px;
                    }

                    .btn-group .btn:last-child {
                        border-radius: 0 3px 3px 0;
                    }

                    .btn-group .btn:not(:last-child) {
                        border-right: none;
                    }

            .btn-group-sm .btn {
                padding: 2px 5px;
                font-size: 8px;
            }

            /* ── SUB-CARDS (pickup/delivery/collection) ───────────────────────────── */
            .delivery-row {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr;
                gap: 2px;
            }

            .delivery-col {
                min-width: 0;
            }

            .sub-card {
                border: 1px solid #dadce0;
                border-radius: 4px;
                overflow: hidden;
                background: #fff;
                display: flex;
                flex-direction: column;
                box-shadow: 0 1px 3px rgba(0,0,0,.08);
            }

            .sub-card-header {
                padding: 4px 8px;
                font-size: 10px;
                font-weight: 700;
                color: #fff;
                display: flex;
                align-items: center;
                gap: 4px;
                flex-shrink: 0;
                letter-spacing: 0.2px;
            }

            .bg-pickup {
                background: linear-gradient(135deg, #34a853 0%, #2d8e47 100%);
            }

            .bg-delivery {
                background: linear-gradient(135deg, #4285f4 0%, #1a73e8 100%);
            }

            .bg-collection {
                background: linear-gradient(135deg, #fbbc04 0%, #f57c00 100%);
            }

            .sub-card-body {
                padding: 4px 6px;
                flex: 1;
                overflow-y: auto;
            }

                .sub-card-body .form-group {
                    flex-direction: column;
                    gap: 1px;
                    align-items: flex-start;
                    margin-bottom: 2px;
                }

                    .sub-card-body .form-group label {
                        max-width: none;
                        font-size: 10px;
                    }

                .sub-card-body .form-control,
                .sub-card-body .form-select {
                    width: 100%;
                    flex: none;
                }

            /* ── TABLES ───────────────────────────────────────────────────────────── */
            .table-responsive {
                overflow-x: auto;
                margin: 0;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9px;
            }

                table th, table td {
                    padding: 3px 4px;
                    border: 1px solid #dadce0;
                    vertical-align: middle;
                }

                table thead th {
                    background: #f8f9fa;
                    font-weight: 700;
                    color: #1a73e8;
                    white-space: nowrap;
                }

                table tbody tr:hover {
                    background: #f8f9fa;
                }

                table td select, table td input {
                    height: 22px;
                    font-size: 9px;
                    padding: 2px 4px;
                    width: 100%;
                }

            /* ── FOOTER ACTIONS ───────────────────────────────────────────────────── */
            .rot-footer {
                flex: 0 0 auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 5px;
                padding: 6px 12px;
                background: #fff;
                border-top: 1px solid #dadce0;
                box-shadow: 0 -2px 8px rgba(0,0,0,.08);
                z-index: 10;
                height: 42px;
            }

                .rot-footer .btn {
                    padding: 5px 12px;
                    font-size: 10px;
                }

            /* ── REMARKS AREA ─────────────────────────────────────────────────────── */
            .remarks-row {
                padding: 4px 6px;
                background: #f8f9fa;
                border-top: 1px solid #dadce0;
                margin-top: 2px;
                border-radius: 0 0 4px 4px;
            }

                .remarks-row .form-group {
                    flex-direction: column;
                    gap: 2px;
                    align-items: flex-start;
                }

                .remarks-row label {
                    font-size: 10px;
                    font-weight: 600;
                }

                .remarks-row textarea {
                    font-size: 10px;
                    resize: none;
                    width: 100%;
                    font-family: 'Roboto', inherit;
                }

            /* ── UTILITY CLASSES ──────────────────────────────────────────────────── */
            .text-center {
                text-align: center;
            }

            .text-muted {
                color: #5f6368;
            }

            .text-success {
                color: #34a853;
            }

            .text-danger {
                color: #d32f2f;
            }

            .text-info {
                color: #4285f4;
            }

            .py-2 {
                padding-top: 2px;
                padding-bottom: 2px;
            }

            .d-block {
                display: block;
            }

            .d-flex {
                display: flex;
            }

            .w-100 {
                width: 100%;
            }

            .action-icon {
                cursor: pointer;
                font-size: 10px;
                opacity: 0.75;
                transition: opacity .2s;
            }

                .action-icon:hover {
                    opacity: 1;
                }

            /* ── RESPONSIVE ADJUSTMENTS ───────────────────────────────────────────── */
            @@media (max-width: 1400px) {
                .form-group {
                    min-width: 130px;
                }
            
                .delivery-row {
                    grid-template-columns: 1fr 1fr 1fr;
                }
            }

            @@media (max-width: 1200px) {
                .form-group {
                    min-width: 120px;
                }
            }
    </style>
</head>
<body>

    <div class="rot-shell">
        <!-- ① TOP HEADER -->
        <header class="main-header">
            <h1><i class="fas fa-truck-fast"></i> Request of Transport Order Management</h1>
            <div class="header-info">
                <div><i class="far fa-calendar-alt"></i> 2024-04-24 11:25</div>
                <div><i class="far fa-user"></i> Admin</div>
            </div>
        </header>

        <!-- ② MAIN CONTENT - ALL SECTIONS STACKED -->
        <div class="rot-content">

            <!-- SECTION 1 — GENERAL INFORMATION -->
            <div class="section-block">
                <div class="section-title">
                    <i class="fas fa-info-circle"></i> General Information
                </div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>ROT Number <span class="required-star">*</span></label>
                            <input type="text" class="form-control" value="ROT-2024-001" readonly />
                        </div>
                        <div class="form-group">
                            <label>Delivery Date</label>
                            <input type="datetime-local" class="form-control" value="2024-04-24T11:25" />
                        </div>
                        <div class="form-group">
                            <label>Business Type</label>
                            <input type="text" class="form-control" value="HAULAGE-HAULAGE" readonly />
                        </div>
                        <div class="form-group">
                            <label>Job Type <span class="required-star">*</span></label>
                            <select class="form-select">
                                <option>Select Job Type</option>
                                <option>EXPORT</option>
                                <option>IMPORT</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Job Process <span class="required-star">*</span></label>
                            <select class="form-select">
                                <option>ROUND TRIP</option>
                                <option>ONE WAY</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Service Type <span class="required-star">*</span></label>
                            <select class="form-select">
                                <option>Select Service Type</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Commodity</label>
                            <input type="text" class="form-control" placeholder="Search" />
                        </div>
                        <div class="form-group">
                            <label>Branch</label>
                            <input type="text" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Sub Branch</label>
                            <select class="form-select">
                                <option>Select Sub Unit</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Tariff Surcharge</label>
                            <select class="form-select" multiple style="height:50px;">
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2 — BILLING INFORMATION -->
            <div class="section-block">
                <div class="section-title">
                    <i class="fas fa-credit-card"></i> Billing Information
                </div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Bill To <span class="required-star">*</span></label>
                            <input type="text" class="form-control" value="SINGLE GLORY SDN BHD" />
                        </div>
                        <div class="form-group">
                            <label>Contact Person</label>
                            <input type="text" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input type="text" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Base Tariff</label>
                            <select class="form-select">
                                <option>Select Tariff</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Tariff Location</label>
                            <select class="form-select">
                                <option>Select Location</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group full-width">
                            <label>Billing Address</label>
                            <textarea class="form-control" style="min-height:32px;">TBA</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 3 — TRANSPORT PARTIES INFORMATION -->
            <div class="section-block">
                <div class="section-title">
                    <i class="fas fa-users"></i> Transport Parties Information
                </div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Booking Party <span class="required-star">*</span></label>
                            <input type="text" class="form-control" placeholder="Ref No." />
                        </div>
                        <div class="form-group">
                            <label>Shipper/Consignee</label>
                            <input type="text" class="form-control" placeholder="Ref No." />
                        </div>
                        <div class="form-group">
                            <label>Routing Party</label>
                            <input type="text" class="form-control" placeholder="Ref No." />
                        </div>
                        <div class="form-group">
                            <label>Forwarding Agent</label>
                            <input type="text" class="form-control" placeholder="Ref No." />
                        </div>
                        <div class="form-group">
                            <label>Shipping Agent</label>
                            <input type="text" class="form-control" placeholder="Ref No." />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Load Port <span class="required-star">*</span></label>
                            <input type="text" class="form-control" placeholder="Search" />
                        </div>
                        <div class="form-group">
                            <label>Discharge Port</label>
                            <input type="text" class="form-control" placeholder="Search" />
                        </div>
                        <div class="form-group">
                            <label>Terminal Name <span class="required-star">*</span></label>
                            <input type="text" class="form-control" placeholder="Search" />
                        </div>
                        <div class="form-group">
                            <label>Vessel Name</label>
                            <input type="text" class="form-control" placeholder="Search" />
                        </div>
                        <div class="form-group">
                            <label>Closing Date Time</label>
                            <input type="datetime-local" class="form-control" value="2024-04-24T11:25" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 4 — DELIVERY & COLLECTION INFORMATION -->
            <div class="section-block">
                <div class="section-title">
                    <i class="fas fa-map-location-dot"></i> Delivery & Collection Information
                </div>
                <div class="section-body">
                    <div class="delivery-row">
                        <div class="delivery-col">
                            <div class="sub-card">
                                <div class="sub-card-header bg-pickup">
                                    <i class="fas fa-box-open"></i> Pick Up
                                </div>
                                <div class="sub-card-body">
                                    <div class="form-group">
                                        <label>Pick Up From <span class="required-star">*</span></label>
                                        <input type="text" class="form-control" placeholder="Search" />
                                    </div>
                                    <div class="form-group">
                                        <label>Pick Up Address</label>
                                        <textarea class="form-control" style="min-height:32px;"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="delivery-col">
                            <div class="sub-card">
                                <div class="sub-card-header bg-delivery">
                                    <i class="fas fa-truck-ramp-box"></i> Delivery
                                </div>
                                <div class="sub-card-body">
                                    <div class="form-group">
                                        <label>Deliver To <span class="required-star">*</span></label>
                                        <input type="text" class="form-control" value="SINGLE GLORY SDN BHD" />
                                    </div>
                                    <div class="form-group">
                                        <label>Delivery Address</label>
                                        <textarea class="form-control" style="min-height:32px;">TBA</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="delivery-col">
                            <div class="sub-card">
                                <div class="sub-card-header bg-collection">
                                    <i class="fas fa-warehouse"></i> Collection
                                </div>
                                <div class="sub-card-body">
                                    <div class="form-group">
                                        <label>Collection Return To <span class="required-star">*</span></label>
                                        <input type="text" class="form-control" placeholder="Search" />
                                    </div>
                                    <div class="form-group">
                                        <label>Collection Address</label>
                                        <textarea class="form-control" style="min-height:32px;"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 5 — REQUIRED QUANTITY -->
            <div class="section-block">
                <div class="section-title">
                    <i class="fas fa-list-check"></i> Required Quantity
                </div>
                <div class="section-body">
                    <div style="display:flex; gap:4px; margin-bottom:4px;">
                        <button class="btn btn-light"><i class="fas fa-file-download"></i> Sample</button>
                        <button class="btn btn-success"><i class="fas fa-file-excel"></i> Upload</button>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>SL</th>
                                    <th>Size</th>
                                    <th>Type</th>
                                    <th>Weight</th>
                                    <th>Qty</th>
                                    <th>Delivery Required</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center">1</td>
                                    <td><select class="form-select"><option>Select</option></select></td>
                                    <td><select class="form-select"><option>Select</option></select></td>
                                    <td><input type="text" class="form-control" value="0" /></td>
                                    <td><input type="text" class="form-control" value="1" /></td>
                                    <td>
                                        <div class="btn-group btn-group-sm w-100">
                                            <button class="btn btn-primary">DateTime</button>
                                            <button class="btn btn-outline-secondary">TBA</button>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <i class="fas fa-save text-success action-icon"></i>
                                        <i class="fas fa-trash-alt text-danger action-icon" style="margin-left:3px;"></i>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- SECTION 6 — CONTAINER DETAILS -->
            <div class="section-block">
                <div class="section-title">
                    <i class="fas fa-boxes-stacked"></i> Container Details
                </div>
                <div class="section-body">
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>SL</th>
                                    <th>Container No.</th>
                                    <th>Seal No.</th>
                                    <th>Size</th>
                                    <th>Type</th>
                                    <th>Weight</th>
                                    <th>Temp</th>
                                    <th>Handling</th>
                                    <th>Service</th>
                                    <th>Gate Pass</th>
                                    <th>Remark</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="12" class="text-center text-muted py-2">
                                        <i class="fas fa-folder-open d-block" style="font-size:13px; margin-bottom:2px;"></i>
                                        No container details added yet.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="remarks-row">
                        <div class="form-group">
                            <label>General Remarks</label>
                            <textarea class="form-control" placeholder="Enter remarks..." style="min-height:28px;"></textarea>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ③ FOOTER ACTIONS -->
        <footer class="rot-footer">
            <button class="btn btn-outline-secondary"><i class="fas fa-times"></i> Cancel</button>
            <button class="btn btn-success"><i class="fas fa-save"></i> Save ROT Draft</button>
            <button class="btn btn-primary"><i class="fas fa-paper-plane"></i> Save & Process CN</button>
        </footer>

    </div>
    @section Scripts {
        <!-- Select2 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

        <!-- jQuery UI CSS -->
        <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

        <!-- jQuery UI -->
        <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

        <!-- Select2 -->
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

        <script src="~/js/rot/create.js"></script>
    }
</body>
</html> *@