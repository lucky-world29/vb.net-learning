@model List<vCore_MVC.Models.CoreBranch>


<style>

    /* ===============================
           TABLE
        =============================== */

    .custom-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .custom-table thead th {
            background: #f4f6fb;
            font-size: 14px;
            font-weight: 700;
            color: #111827;
            padding: 14px 12px;
            border-bottom: 2px solid #dee2e6;
            white-space: nowrap;
            vertical-align: middle;
        }

        .custom-table tbody td {
            padding: 10px 12px;
            font-size: 13px;
            color: #374151;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .custom-table tbody tr {
            transition: .2s ease;
        }

            .custom-table tbody tr:hover {
                background: #f9fafb;
            }

    /* ===============================
           ACTION BUTTONS
        =============================== */

    .icon-btn {
        border: none;
        background: #f3f4f6;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        margin-right: 6px;
        transition: .2s;
    }

        .icon-btn i {
            font-size: 14px;
        }

        .icon-btn:hover {
            transform: translateY(-2px);
            background: #e5e7eb;
        }

    /* ===============================
           STATUS BADGE
        =============================== */

    .status-badge {
        padding: 7px 18px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        min-width: 90px;
        text-align: center;
    }

    .active-badge {
        background: #6fd3b1;
        color: white;
    }

    .inactive-badge {
        background: #e76f51;
        color: white;
    }

    /* ===============================
           DATATABLE
        =============================== */

    div.dataTables_filter {
        text-align: right;
    }

    .dt-buttons {
        display: flex;
        gap: 8px;
    }

        .dt-buttons .btn {
            border-radius: 8px;
            font-size: 13px;
            padding: 6px 14px;
        }

    .dataTables_length select {
        border-radius: 8px;
        padding: 4px 28px 4px 10px;
    }

    .dataTables_filter input {
        border-radius: 8px;
        margin-left: 6px;
    }

    .page-link {
        border-radius: 6px !important;
        margin: 0 2px;
    }

    /* ===============================
           MODAL
        =============================== */

    .modal-content {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        animation: modalFade .25s ease;
    }

    .modal-header {
        padding: 18px 24px;
    }

    .modal-title {
        letter-spacing: .3px;
    }

    .modal-footer {
        padding-top: 0;
    }

    /* ===============================
           FORM INPUTS
        =============================== */

    .custom-input {
        height: 48px;
        border-radius: 12px;
        border: 1px solid #d1d5db;
        padding-left: 14px;
        font-size: 14px;
        transition: .2s;
    }

        .custom-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .15rem rgba(13,110,253,.15);
        }

    /* ===============================
           EMPTY SUB UNIT
        =============================== */

    .empty-subunit {
        border: 2px dashed #d1d5db;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        background: #f9fafb;
        color: #6b7280;
        font-weight: 500;
    }

    /* ===============================
           ANIMATION
        =============================== */

    @@keyframes modalFade {

        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    /* ===================================
       DATATABLE TOP BUTTONS
    =================================== */

    .dt-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        /* COMMON BUTTON STYLE */
        .dt-buttons .btn {
            height: 40px;
            border-radius: 12px !important;
            padding: 0 18px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            border: none !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .2s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,.08);
        }

    /* COLUMN BUTTON */
    .buttons-colvis {
        background: #6366f1 !important;
        color: white !important;
    }

        .buttons-colvis:hover {
            background: #4f46e5 !important;
            transform: translateY(-1px);
        }

    /* EXPORT BUTTON */
    .buttons-collection {
        background: #111827 !important;
        color: white !important;
    }

        .buttons-collection:hover {
            background: #1f2937 !important;
            transform: translateY(-1px);
        }

    /* DROPDOWN MENU */
    .dt-button-collection {
        border: none !important;
        border-radius: 14px !important;
        overflow: hidden;
        padding: 8px !important;
        box-shadow: 0 10px 30px rgba(0,0,0,.12) !important;
    }

        /* DROPDOWN ITEMS */
        .dt-button-collection .dt-button {
            border-radius: 10px !important;
            margin-bottom: 4px !important;
            font-size: 13px !important;
            font-weight: 500 !important;
            background: white !important;
            color: #111827 !important;
            border: none !important;
            transition: .2s;
        }

            .dt-button-collection .dt-button:hover {
                background: #f3f4f6 !important;
                color: #111827 !important;
            }

    /* ACTIVE COLUMN ITEM */
    .dt-button.active {
        background: #eef2ff !important;
        color: #4338ca !important;
    }
    .validation-msg {
        font-size: 12px;
    }

    .is-invalid {
        border: 1px solid red !important;
    }

    .subUnitRow {
        transition: .2s;
    }

        .subUnitRow:hover {
            box-shadow: 0 4px 12px rgba(0,0,0,.05);
        }
</style>


<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">

        <h5 class="mb-0 fw-bold text-dark">
            Branch Management
        </h5>

        <button type="button"
                id="btnAddBranch"
                class="btn btn-primary btn-sm rounded-pill">

            <i class="fa fa-plus me-1"></i>

            Add Branch

        </button>

    </div>

    <div class="card border-0 shadow-lg rounded-3">

        <div class="card-body">

            <table id="branchTable"
                   class="table align-middle custom-table">

                <thead>
                    <tr>

                        <th style="width:160px;">Actions</th>

                        <th style="width:50px;">
                            <input type="checkbox"
                                   id="selectAll">
                        </th>

                        <th>Name</th>

                        <th>Code</th>

                        <th>Branch Sub Units</th>

                        <th>Status</th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="text-nowrap">

                                <!-- VIEW -->
                                <button class="icon-btn text-success viewBtn"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-code="@item.ShortCode"
                                        data-status="@item.Status">

                                    <i class="fa fa-eye"></i>

                                </button>

                                <!-- EDIT -->
                                <button class="icon-btn text-primary editBtn"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-code="@item.ShortCode">

                                    <i class="fa fa-pen"></i>

                                </button>

                                <!-- DELETE -->
                                <button class="icon-btn text-danger deleteBtn"
                                        data-id="@item.Id">

                                    <i class="fa fa-trash"></i>

                                </button>

                            </td>

                            <td>
                                <input type="checkbox" class="rowCheckbox">
                            </td>

                            <td class="fw-semibold">
                                @item.Name
                            </td>

                            <td>
                                @item.ShortCode
                            </td>

                            <td>
                                No Sub Units
                            </td>

                            <td>

                                @if (item.Status == 1)
                                {
                                    <span class="status-badge active-badge">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive-badge">
                                        Inactive
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    
</div>

@*============================================ VIEW MODAL ======================================== *@
<div class="modal fade"
     id="viewModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white border-0">

                <h5 class="modal-title fw-bold">
                    <i class="fa fa-eye me-2"></i>
                    Branch Details
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body p-4"
                 id="viewModalBody">
            </div>

        </div>

    </div>

</div>

@*=========================================== EDIT MODAL ======================================== *@

<div class="modal fade"  id="editModal" tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white border-0">

                <h4 class="modal-title fw-bold">

                    <i class="fa fa-code-branch me-2"></i>

                    Update Branch & Branch Sub Units

                </h4>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body p-4"
                 style="background:#f8fafc;">

                <input type="hidden"
                       id="editId">

                <!-- CARD -->
                <div class="card border-0 shadow rounded-4">

                    <div class="card-body p-4">
                        <!-- SECTION TITLE -->
                        <h5 class="fw-bold mb-4 text-dark">
                            <i class="fa fa-building me-2 text-primary"></i>
                            Branch Information
                        </h5>

                        <!-- FORM -->
                        <div class="row g-4">
                            <!-- NAME -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Branch Name
                                </label>
                                <input type="text"
                                       id="editName"
                                       class="form-control custom-input"
                                       placeholder="Enter branch name">
                                <small class="text-danger d-none"
                                       id="nameValidation">

                                    Branch Name is required.

                                </small>
                            </div>

                            <!-- CODE -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Branch ShortCode
                                </label>
                                <input type="text"
                                       id="editCode"
                                       class="form-control custom-input"
                                       placeholder="Enter shortcode">
                                <small class="text-danger d-none"
                                       id="codeValidation">

                                    Branch ShortCode is required.

                                </small>
                            </div>
                        </div>

                        <!-- SUB UNITS -->
                        <div class="mt-5">

                            <h5 class="fw-bold text-dark mb-4">

                                <i class="fa fa-sitemap me-2 text-primary"></i>

                                Branch Sub Units

                            </h5>

                            <!-- SUB UNIT CONTAINER -->
                            <div id="subUnitContainer">
                            </div>

                            <!-- ADD BUTTON -->
                            <button type="button"
                                    id="addSubUnitBtn"
                                    class="btn btn-dark rounded-pill px-4 py-2 fw-semibold mt-2">

                                <i class="fa fa-plus me-2"></i>

                                Add Branch Sub Unit

                            </button>

                        </div>

                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer border-0 bg-white px-4 pb-4">

                <button class="btn btn-light border rounded-pill px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="saveBranchBtn"
                        class="btn btn-primary rounded-pill px-4">

                    <i class="fa fa-save me-2"></i>

                    Save Changes

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts{
        <script>
            let branchModal = new bootstrap.Modal(document.getElementById('editModal'));

            // =====================================
            // DATATABLE
            // =====================================
            $('#branchTable').DataTable({

            responsive: true,

            destroy: true,

            lengthMenu: [10, 25, 50, 100],

            pageLength: 10,

            order: [[2, 'asc']],

            dom:
            "<'row mb-3 align-items-center'<'col-md-6 d-flex align-items-center'l><'col-md-6 d-flex justify-content-end gap-2'Bf>>" +
            "rt" +
            "<'row mt-3'<'col-md-6'i><'col-md-6'p>>",

            buttons: [

            {
            extend: 'colvis',

            text: '<i class="fa fa-table-columns me-2"></i> Columns',

            className: 'btn btn-outline-secondary btn-sm'
            },

            {
            extend: 'collection',

            text: '<i class="fa fa-download me-2"></i> Export',

            className: 'btn btn-outline-dark btn-sm',

            buttons: [

            'pdf',
            'excel',
            'csv',
            'copy',
            'print'

            ]
            }

            ]

            });
        
            // =====================================
            // SELECT ALL
            // =====================================
            $('#selectAll').on('change', function () {

                $('.rowCheckbox').prop(
                    'checked',
                    $(this).prop('checked')
                );

            });

            function clearBranchForm() {
                $('#editId').val('');
                $('#editName').val('');
                $('#editCode').val('');
                $('#subUnitContainer').empty();

                $('#nameValidation').addClass('d-none');
                $('#codeValidation').addClass('d-none');

                $('#editName').removeClass('is-invalid');
                $('#editCode').removeClass('is-invalid');
            }

            $('#btnAddBranch').on('click', function () {
                clearBranchForm();
                branchModal.show();
            });

            $('#addSubUnitBtn').on('click', function () {
                let branchName = $('#editName').val().trim();
                let branchCode = $('#editCode').val().trim();
                let isValid = true;

                if (branchName === '') {
                    $('#nameValidation').removeClass('d-none');
                    $('#editName').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#nameValidation').addClass('d-none');
                    $('#editName').removeClass('is-invalid');
                }

                if (branchCode === '') {
                    $('#codeValidation').removeClass('d-none');
                    $('#editCode').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#codeValidation').addClass('d-none');
                    $('#editCode').removeClass('is-invalid');
                }

                if (!isValid) return;

                let html = `
                    <div class="subUnitRow border rounded-4 p-3 mb-3 bg-light">
                        <div class="row align-items-end g-3">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Branch Sub Unit Name</label>
                                <input type="text" class="form-control custom-input subName">
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Branch Sub Unit ShortCode</label>
                                <input type="text" class="form-control custom-input subCode">
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger removeSubUnit w-100">Remove</button>
                            </div>
                        </div>
                    </div>
                `;

                $('#subUnitContainer').append(html);
            });

            $(document).on('click', '.removeSubUnit', function () {
                $(this).closest('.subUnitRow').remove();
            });

            $('#saveBranchBtn').on('click', function () {
                let branchName = $('#editName').val().trim();
                let branchCode = $('#editCode').val().trim();

                let isValid = true;

                if (branchName === '') {
                    $('#nameValidation').removeClass('d-none');
                    $('#editName').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#nameValidation').addClass('d-none');
                    $('#editName').removeClass('is-invalid');
                }

                if (branchCode === '') {
                    $('#codeValidation').removeClass('d-none');
                    $('#editCode').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#codeValidation').addClass('d-none');
                    $('#editCode').removeClass('is-invalid');
                }

                if (!isValid) return;

                let subUnits = [];

                $('.subUnitRow').each(function () {
                    let subName = $(this).find('.subName').val().trim();
                    let subCode = $(this).find('.subCode').val().trim();

                    if (subName !== '' || subCode !== '') {
                        subUnits.push({
                            Name: subName,
                            ShortCode: subCode
                        });
                    }
                });

                let model = {
                    Branch: {
                     Id: parseInt($('#editId').val()) || 0,
                    Name: branchName,
                    ShortCode: branchCode
                },
                SubUnits: subUnits
            };

       console.log(model); /*========================For Testing========================*/

         console.log(JSON.stringify(model)); /*========================For Testing========================*/

                $.ajax({
                    url: '/OrganisationMaster/SaveBranch',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function (res) {
                        if (res.success) {
                            branchModal.hide();
                            location.reload();
                        } else {
                            alert(res.message || 'Save failed');
                        }
                    },
                    error: function () {
                        alert('Something went wrong');
                    }
                });
            });

                    // =====================================
            // VIEW BRANCH
            // =====================================
            $(document).on('click', '.viewBtn', function () {

                let name = $(this).data('name');

                let code = $(this).data('code');

                let status = $(this).data('status');

                let html = `

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body p-4">

                            <div class="mb-4">

                                <label class="fw-bold text-muted small">
                                    Branch Name
                                </label>

                                <div class="fs-5 fw-semibold">
                                    ${name}
                                </div>

                            </div>

                            <div class="mb-4">

                                <label class="fw-bold text-muted small">
                                    Branch ShortCode
                                </label>

                                <div class="fs-6">
                                    ${code}
                                </div>

                            </div>

                            <div>

                                <label class="fw-bold text-muted small">
                                    Status
                                </label>

                                <div>

                                    ${status == 1
                                        ? '<span class="badge bg-success px-3 py-2">Active</span>'
                                        : '<span class="badge bg-danger px-3 py-2">Inactive</span>'}

                                </div>

                            </div>

                        </div>

                    </div>

                `;

                $('#viewModalBody').html(html);

                let viewModal = new bootstrap.Modal(
                    document.getElementById('viewModal')
                );

                viewModal.show();

            });

            // =====================================
            // EDIT BRANCH
            // =====================================
            $(document).on('click', '.editBtn', function () {

                clearBranchForm();

                let id = $(this).data('id');

                let name = $(this).data('name');

                let code = $(this).data('code');

                $('#editId').val(id);

                $('#editName').val(name);

                $('#editCode').val(code);

                branchModal.show();

            });


                    // =====================================
            // DELETE BRANCH
            // =====================================
            $(document).on('click', '.deleteBtn', function () {

                let id = $(this).data('id');

                if (!confirm('Are you sure you want to delete this branch?'))
                    return;

                $.ajax({

                    url: '/OrganisationMaster/DeleteBranch',

                    type: 'POST',

                    data: {
                        id: id
                    },

                    success: function (res) {

                        if (res.success) {

                            location.reload();

                        }
                        else {

                            alert('Delete failed');

                        }

                    },

                    error: function () {

                        alert('Something went wrong');

                    }

                });

            });
        </script>
}
