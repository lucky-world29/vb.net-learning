
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>vCORE | Professional Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Lato:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/GussNewIco.ico">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Lato', sans-serif;
                background-color: #faf8f3;
                color: #5a5a5a;
                overflow-x: hidden;
            }

            h1, h2, h3, h4, h5, h6 {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                color: #5a5a5a;
            }


            .login-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }
                /* Subtle background texture */
                .login-container::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: linear-gradient(135deg, rgba(209, 123, 146, 0.03) 0%, rgba(122, 155, 142, 0.03) 100%);
                    pointer-events: none;
                    z-index: 0;
                }

            .login-panel {
                position: relative;
                z-index: 10;
                width: 100%;
                max-width: 420px;
                padding: 2rem;
                animation: slideInUp 0.7s ease-out;
            }

            @@keyframes slideInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .logo-section {
                margin-bottom: 2rem;
            }

            .logo-text {
                font-size: 2.5rem;
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                color: #5a5a5a;
                margin-bottom: 0.5rem;
                letter-spacing: -1px;
            }

            .logo-o {
                height: 1em; /* match text height */
                width: 1em;
                border-radius: 50%;
                object-fit: cover;
                display: inline-block;
                vertical-align: middle;
            }

            .welcome-text {
                font-size: 0.875rem;
                color: #8a8a8a;
                font-weight: 400;
            }

            .login-heading {
                font-size: 2rem;
                font-weight: 700;
                color: #5a5a5a;
                margin-bottom: 1.5rem;
                letter-spacing: -0.5px;
            }

            .form-group {
                margin-bottom: 1.5rem;
            }

            .form-label {
                font-size: 0.875rem;
                font-weight: 600;
                color: #5a5a5a;
                margin-bottom: 0.5rem;
                display: block;
            }

            .form-control {
                background-color: #f5f1eb;
                border: 1px solid #e8dfd4;
                border-radius: 1.25rem;
                padding: 0.875rem 1rem;
                font-family: 'Lato', sans-serif;
                font-size: 0.95rem;
                color: #5a5a5a;
                transition: all 0.3s ease;
            }

                .form-control::placeholder {
                    color: #b0a89f;
                }

                .form-control:focus {
                    background-color: #faf8f3;
                    border-color: #d17b92;
                    box-shadow: 0 0 0 3px rgba(209, 123, 146, 0.1);
                    outline: none;
                }

            .password-wrapper {
                position: relative;
            }

            .password-toggle {
                position: absolute;
                right: 1rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: #8a8a8a;
                transition: color 0.3s ease;
                padding: 0.5rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .password-toggle:hover {
                    color: #5a5a5a;
                }

            .login-btn {
                width: 100%;
                background-color: #d17b92;
                color: #faf8f3;
                border: none;
                border-radius: 1.25rem;
                padding: 0.875rem 1.5rem;
                font-size: 1rem;
                font-weight: 600;
                font-family: 'Lato', sans-serif;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                margin-top: 1.5rem;
            }

                .login-btn:hover {
                    background-color: #c0657f;
                    transform: scale(1.02);
                    box-shadow: 0 8px 20px rgba(209, 123, 146, 0.3);
                }

                .login-btn:active {
                    transform: scale(0.98);
                }

                .login-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                    transform: scale(1);
                }
                
            .btn-spinner {
                display: inline-block;
                width: 16px;
                height: 16px;
                border: 2px solid rgba(250, 248, 243, 0.3);
                border-top-color: #faf8f3;
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .error-message {
                background-color: rgba(196, 30, 58, 0.1);
                border: 1px solid rgba(196, 30, 58, 0.3);
                border-radius: 0.75rem;
                padding: 0.75rem 1rem;
                font-size: 0.875rem;
                color: #c41e3a;
                margin-bottom: 1rem;
                display: none;
                animation: fadeIn 0.3s ease;
            }

                .error-message.show {
                    display: block;
                }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            .success-message {
                background-color: rgba(122, 155, 142, 0.1);
                border: 1px solid rgba(122, 155, 142, 0.3);
                border-radius: 0.75rem;
                padding: 0.75rem 1rem;
                font-size: 0.875rem;
                color: #7a9b8e;
                margin-bottom: 1rem;
                display: none;
                animation: fadeIn 0.3s ease;
            }

                .success-message.show {
                    display: block;
                }


            /* ========================================
                        RESPONSIVE DESIGN
               ======================================== */

            @@media (max-width: 768px) {
                .login-panel {
                    max-width: 100%;
                    padding: 1.5rem;
                }

                .logo-text {
                    font-size: 2rem;
                }

                .login-heading {
                    font-size: 1.5rem;
                }

                .form-control {
                    padding: 0.75rem 0.875rem;
                }
            }

            @@media (max-width: 480px) {
                .login-panel {
                    padding: 1rem;
                }

                .logo-text {
                    font-size: 1.75rem;
                }

                .login-heading {
                    font-size: 1.25rem;
                }

                .logo-section {
                    margin-bottom: 1.5rem;
                }

                .form-group {
                    margin-bottom: 1rem;
                }

                .login-btn {
                    padding: 0.75rem 1rem;
                    font-size: 0.95rem;
                }
            }

            /* Footer */
            .footer {
                position: fixed;
                bottom: 0;
                width: 100%;
                height: 45px;
                background: #ffe4ec; /* light pink */
                overflow: hidden;
                display: flex;
                align-items: center;
            }

            /* Scrolling text */
            .scroll-text {
                white-space: nowrap;
                color: #ffffff; /* white text */
                font-weight: bold;
                font-size: 16px;
                padding-left: 100%;
                animation: scroll 30s linear infinite;
            }

            /* Pause on hover */
            .footer:hover .scroll-text {
                animation-play-state: paused;
            }

            /* Animation */
            @@keyframes scroll {
                from {
                    transform: translateX(0);
                }

                to {
                    transform: translateX(-100%);
                }
            }

    </style>
</head>

<body>

    <div class="login-container">
        <div class="login-panel">

            <h1 class="logo-text d-flex align-items-center gap-1">
                vC
                <img src="~/Images/GussNewIco.png" class="logo-o" alt="O" />
                RE
            </h1>
            <p>Welcome back</p>

            <h2 class="login-heading">Sign In</h2>

            <div class="error-message" id="errorMessage"></div>
            <div class="success-message" id="successMessage"></div>

            <form id="loginForm" method="post" action="/Home/Login">

                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" name="UserName" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <input type="password" id="password" name="Password" class="form-control" required>
                        <span class="input-group-text" onclick="togglePassword()">
                            <i id="eyeIcon" class="bi bi-eye"></i>
                        </span>
                    </div>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="RememberMe" name="RememberMe">
                    <label class="form-check-label" for="RememberMe">Remember Me</label>
                </div>
                <button type="submit" class="login-btn" id="loginBtn">
                    <span>Sign In</span>
                    <span>→</span>
                </button>

            </form>
            
        </div>
        <div class="footer">
            <div class="scroll-text">
                🔐 Login → Username: Lucky_01 | Password: Lucky@123
            </div>
        </div>
    </div>

    <script>
            const loginForm = document.getElementById('loginForm');
            const loginBtn = document.getElementById('loginBtn');
            const errorMessage = document.getElementById('errorMessage');
            const successMessage = document.getElementById('successMessage');
            // var data = {
            //     UserName: $("#UserName").val(),
            //     Password: $("#Password").val(),
            //     RememberMe: $("#RememberMe").is(":checked") ✅ important
            // };
            function togglePassword() {
                const pwd = document.getElementById("password");
                const icon = document.getElementById("eyeIcon");

                if (pwd.type === "password") {
                    pwd.type = "text";
                    icon.classList.replace("bi-eye", "bi-eye-slash");
                } else {
                    pwd.type = "password";
                    icon.classList.replace("bi-eye-slash", "bi-eye");
                }
            }

                loginForm.addEventListener('submit', function (e) {
                e.preventDefault();

                // Hide messages
                errorMessage.classList.remove('show');
                successMessage.classList.remove('show');

                const username = document.getElementById("username").value;
                const password = document.getElementById("password").value;
                const rememberMe = document.getElementById("RememberMe").checked;


                //  UI LOADING (your animation)
                loginBtn.disabled = true;
                const originalContent = loginBtn.innerHTML;
                loginBtn.innerHTML = '<div class="btn-spinner"></div> <span>Signing in...</span>';

                //  Small delay for smooth UX (optional)
                setTimeout(() => {
                        const formData = new URLSearchParams();
                            formData.append("UserName", username);
                            formData.append("Password", password);
                            // formData.append("RememberMe", rememberMe);
                            formData.append("RememberMe", rememberMe ? "true" : "false");
                    //  API CALL
                    fetch('/Home/Login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                         body: formData
                    })
                    .then(res => res.json())
                    .then(response => {

                        if (response.success) {
                            //  SUCCESS UI
                            ;
                            successMessage.textContent = '✓ Login successful! Redirecting...';
                            successMessage.classList.add('show');

                            setTimeout(() => {
                                window.location.href = '/Home/Index';
                            }, 800);

                        } else {
                            //  ERROR UI
                           // alert(response.message);
                            window.alert(username + " " + password);
                            errorMessage.textContent = 'Invalid email or password ' + response.message;
                            errorMessage.classList.add('show');
                        }

                        // Reset button
                        loginBtn.disabled = false;
                        loginBtn.innerHTML = originalContent;

                    })
                    .catch(() => {
                        errorMessage.textContent = 'Server error';
                        errorMessage.classList.add('show');

                        loginBtn.disabled = false;
                        loginBtn.innerHTML = originalContent;
                    });

                }, 800); //  Small delay for smooth UX 
            });
    </script>

</body>
</html>




