


@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/logo.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <title>vCORE | Professional Login</title>

    <style>
            :root {
                --vcore-primary: #0052CC; /* Royal Blue */
                --vcore-action: #00B8D9; /* Cyan */
                --vcore-bg-start: #F4F5F7; /* Cool Grey */
                --vcore-bg-end: #FFFFFF; /* White */
                --vcore-text-main: #172B4D; /* Deep Navy */
                --vcore-text-muted: #6B778C; /* Slate Grey */
                --vcore-border: #DFE1E6; /* Light Silver */
            }

            body {
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient(to bottom, #cfe9f6, #ffffff);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                margin: 0;
                color: var(--vcore-text-main);
            }

            .login-card {
                width: 420px;
                padding: 48px;
                border-radius: 12px;
                background: #ffffff;
                box-shadow: 0 8px 32px rgba(23, 43, 77, 0.1);
                border: 1px solid var(--vcore-border);
                position: relative;
            }

            .logo-img {
                width: 50px;
                height: auto;
                margin-bottom: 24px;
            }

            h2 {
                color: var(--vcore-text-main);
                font-weight: 700;
                letter-spacing: -0.5px;
            }

            .text-muted-custom {
                color: var(--vcore-text-muted);
                font-size: 0.95rem;
            }

            .form-label {
                font-weight: 600;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--vcore-text-muted);
                margin-bottom: 8px;
            }

            .form-control {
                border-radius: 6px;
                padding: 12px 16px;
                border: 2px solid var(--vcore-border);
                background-color: #FAFBFC;
                transition: all 0.2s ease;
                color: var(--vcore-text-main);
            }

                .form-control:focus {
                    background-color: #ffffff;
                    border-color: var(--vcore-primary);
                    box-shadow: none;
                }

            .input-group-text {
                background-color: #FAFBFC;
                border: 2px solid var(--vcore-border);
                border-left: none;
                color: var(--vcore-text-muted);
                cursor: pointer;
            }

            .password-input {
                border-right: none;
            }

            .btn-login {
                border-radius: 6px;
                padding: 14px;
                font-weight: 700;
                background-color: var(--vcore-action);
                border: none;
                color: white;
                transition: all 0.3s ease;
                margin-top: 10px;
            }

                .btn-login:hover {
                    background-color: #00A3BF;
                    transform: translateY(-1px);
                    box-shadow: 0 4px 12px rgba(0, 184, 217, 0.3);
                    color: white;
                }

            .forgot-link {
                font-size: 0.85rem;
                color: var(--vcore-primary);
                font-weight: 500;
            }

                .forgot-link:hover {
                    text-decoration: underline !important;
                }

            .form-check-input:checked {
                background-color: var(--vcore-primary);
                border-color: var(--vcore-primary);
            }

            /* Loading Overlay */
            #loadingOverlay {
                display: none;
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(255, 255, 255, 0.9);
                border-radius: 12px;
                z-index: 10;
                justify-content: center;
                align-items: center;
                flex-direction: column;
            }

            .spinner-custom {
                color: var(--vcore-primary) !important;
            }

            .shake {
                animation: shake 0.4s ease-in-out;
            }
    </style>
</head>

<body>

    <div class="login-card text-center" id="loginCard">
        <div id="loadingOverlay">
            <div class="spinner-border spinner-custom" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 fw-bold" style="color: var(--vcore-primary)">Authenticating...</p>
        </div>

        <img src="~/Images/GussNewIco.png" alt="vCORE" class="logo-img" onerror="this.src='https://via.placeholder.com/50/0052CC/FFFFFF?text=V'" />
        
        <h2 class="mb-2">Log in to vCORE</h2>
        <p class="text-muted-custom mb-4">Enter your credentials to continue</p>

        <form id="loginForm" onsubmit="handleLogin(event)" autocomplete="off">
            @* <form method="post" asp-action="Login" id="loginForm"  > *@
            <div class="mb-3 text-start">
                <label class="form-label">Email Address</label>
                <input type="email"
                       id="email"
                       name="Email"
                       class="form-control"
                       placeholder="e.g. user@vcore.io"
                       required>
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <input type="password"
                           id="password"
                           name="Password"
                           class="form-control password-input"
                           placeholder="••••••••"
                           required>
                    <span class="input-group-text" onclick="togglePassword()">
                        <i id="eyeIcon" class="bi bi-eye"></i>
                    </span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label small" for="rememberMe" style="color: var(--vcore-text-muted)">
                        Keep me logged in
                    </label>
                </div>
                <a href="#" class="forgot-link text-decoration-none">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-login w-100">
                Log In
            </button>
            
            <div id="errorMessage" class="text-danger small mt-3 fw-bold" style="display: none;">
                <i class="bi bi-exclamation-circle-fill me-1"></i> The email or password you entered is incorrect.
            </div>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="text-danger">@ViewBag.Error</div>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePassword() {
        const pwd = document.getElementById("password");
        const icon = document.getElementById("eyeIcon");

        if (pwd.type === "password") {
        pwd.type = "text";
        icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
        pwd.type = "password";
        icon.classList.replace("bi-eye-slash", "bi-eye");
        }
        }

        // function handleLogin(event) {
        // event.preventDefault();
            
        // const email = document.getElementById("email").value;
        // const password = document.getElementById("password").value;
        // const card = document.getElementById("loginCard");
        // const overlay = document.getElementById("loadingOverlay");
        // const errorMsg = document.getElementById("errorMessage");

        // overlay.style.display = 'flex';
        // errorMsg.style.display = 'none';

        // Simulate Network Latency
        // setTimeout(() => {
        // overlay.style.display = 'none';
                
        // Demo error trigger
        // if (email === "error@vcore.io") {
        // card.classList.add('shake');
        // errorMsg.style.display = 'block';
        // setTimeout(() => card.classList.remove('shake'), 500);
        // } else {
        // Success Simulation
        // const btn = document.querySelector('.btn-login');
        // btn.innerHTML = '<i class="bi bi-check-lg me-2"></i> Success';
        // btn.style.backgroundColor = '#36B37E'; Success Green
        // setTimeout(() => {
        // alert("Authenticated successfully! Redirecting...");
        // }, 500);
        // }
        // }, 1200);
        // }

        function handleLogin(event) {
        event.preventDefault();

        const email = $("#email").val();
        const password = $("#password").val();

        const card = $("#loginCard");
        const overlay = $("#loadingOverlay");
        const errorMsg = $("#errorMessage");
        const btn = $(".btn-login");

        overlay.show();
        errorMsg.hide();

        $.ajax({
        url: '/Home/Login',
        type: 'POST',
        data: {
        Email: email,
        Password: password
        },
        success: function (response) {

        overlay.hide();

        if (response.success) {
        // ✅ SUCCESS UI
        btn.html('<i class="bi bi-check-lg me-2"></i> Success');
        btn.css("background-color", "#36B37E");

        setTimeout(() => {
        window.location.href = '/Home/Index';
        }, 800);
        } else {
        // ❌ ERROR UI
        card.addClass('shake');
        errorMsg.show();

        setTimeout(() => card.removeClass('shake'), 500);
        }
        },
        error: function () {
        overlay.hide();
        alert("Server error");
        }
        });
        fetch('/Home/Logout', {
        method: 'POST'
        })
        .then(res => res.json())
        .then(data => {
        if (data.success) {
        window.location.href = '/Home/Login';
        }
        });
        }
    </script>

</body>
</html>