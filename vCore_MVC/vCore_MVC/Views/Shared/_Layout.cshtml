        <script>
            $(document).ready(function () {
                const sidebar = $("#sidebar");
                const flyout = $("#flyoutMenu");
                let hideTimer = null;
                let currentHoveredItem = null;

                // Sidebar Toggle
                $("#menu-toggle").click(function () {
                    sidebar.toggleClass("collapsed");
                    if (sidebar.hasClass("collapsed")) {
                        $(".submenu.show").collapse('hide');
                    }
                });

                // Flyout Logic for Collapsed State
                $(".nav-item").on("mouseenter", function () {
                    if (!sidebar.hasClass("collapsed")) return;
                
                    clearTimeout(hideTimer);
                    currentHoveredItem = $(this);
                    const rect = this.getBoundingClientRect();
                    const title = $(this).find(".menu-text").first().text();
                
                    flyout.html(title + ' <i class="fas fa-chevron-right ms-2 small opacity-50"></i>')
                          .css({ "top": rect.top + "px", "display": "block" });
                }).on("mouseleave", function () {
                    hideTimer = setTimeout(() => {
                        if (!flyout.is(":hover")) flyout.hide();
                    }, 200);
                });

                flyout.on("mouseenter", () => clearTimeout(hideTimer))
                      .on("mouseleave", () => {
                          hideTimer = setTimeout(() => flyout.hide(), 200);
                      })
                      .on("click", function() {
                          if (currentHoveredItem) {
                              sidebar.removeClass("collapsed");
                              const link = currentHoveredItem.find("a").first();
                              const target = link.attr("href");
                              if (target && target.startsWith("#")) {
                                  $(target).collapse('show');
                              } else {
                                  window.location.href = target;
                              }
                          }
                          flyout.hide();
                      });

                // Search Functionality
                $("#menuSearch").on("keyup", function () {
                    const value = $(this).val().toLowerCase();
                    const links = $("#menuList a.nav-link");

                    links.each(function() {
                        const link = $(this);
                        const textElement = link.find(".menu-text").first();
                        let originalText = textElement.data("original");
                    
                        if (!originalText) {
                            originalText = textElement.text();
                            textElement.data("original", originalText);
                        }

                        if (value !== "" && originalText.toLowerCase().includes(value)) {
                            link.show();
                            const regex = new RegExp(`(${value})`, "gi");
                            textElement.html(originalText.replace(regex, `<span class="menu-highlight">$1</span>`));
                        
                            // Expand parents
                            link.parents(".collapse").collapse('show');
                        } else {
                            textElement.html(originalText);
                            link.toggle(value === "");
                        }
                    });
                });
            });

// ==========================
// ACTIVE MENU + AUTO EXPAND
// ==========================
$(document).ready(function () {

    let currentUrl = window.location.pathname.toLowerCase();

    // loop all nav links
    $(".nav-link").each(function () {

        let link = $(this).attr("href");

        if (!link || link === "#" || link.startsWith("#")) return;

        if (currentUrl.includes(link.toLowerCase())) {

            // highlight current
            $(this).addClass("active");

            // 🔥 expand all parent collapse
            $(this).parents(".collapse").each(function () {
                $(this).addClass("show");
            });

            // 🔥 rotate arrow properly
            $(this).parents(".nav-item").find(".arrow").addClass("rotate");

        }
    });

});
        </script>
    </body>
    </html>

