@model List<vCore_MVC.Models.CoreRole>
@{
    ViewData["Title"] = "Roles Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CSS Links and Styles (your existing styles are good - kept as is) -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />

<!-- Your existing <style> block remains unchanged -->

<div class="container-fluid px-4 py-3">
    <div class="page-title-bar">
        <i class="fas fa-id-badge me-2"></i> Roles Management
    </div>

    <div class="action-bar">
        <button class="btn btn-primary btn-sm px-3" onclick="openCreateModal()">
            <i class="fas fa-plus-circle me-1"></i> Create Role
        </button>
        <button class="btn btn-success btn-sm px-3" onclick="filterByStatus('Active')">Active</button>
        <button class="btn btn-danger btn-sm px-3" onclick="filterByStatus('Inactive')">Inactive</button>
    </div>

    <div class="roles-card p-3">
        <table id="rolesTable" class="table table-striped">
            <thead>
                <tr>
                    <th style="width:130px;">Actions</th>
                    <th style="width:40px;"><input type="checkbox" id="checkAll" /></th>
                    <th>Role Name</th>
                    <th>Role Description</th>
                    <th style="width:120px;">Status</th>
                </tr>   
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr data-id="@role.Id">
                        <td>
                            <div class="action-icons">
                                <button class="act-btn act-view" onclick="viewRole(this)" data-id="@role.Id"><i class="fas fa-eye"></i></button>
                                <button class="act-btn act-edit" onclick="editRole(this)" data-id="@role.Id"><i class="fas fa-pen"></i></button>
                                <button class="act-btn act-delete" onclick="deleteRow(this)" data-id="@role.Id"><i class="fas fa-trash-alt"></i></button>
                            </div>
                        </td>
                        <td><input type="checkbox" /></td>
                        <td>@role.RoleName</td>
                        <td>@role.Description</td>
                        <td>
                            <span class="badge @(role.Status == 1 ? "badge-active" : "badge-inactive") text-white">
                                @(role.Status == 1 ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modals (unchanged structure, minor ID improvements) -->
<!-- Create Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Role Name <span class="text-danger">*</span></label>
                    <input type="text" id="newRoleName" class="form-control" placeholder="e.g. ADMIN" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Role Description <span class="text-danger">*</span></label>
                    <input type="text" id="newRoleDesc" class="form-control" placeholder="e.g. Administration" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select id="newRoleStatus" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveRole()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal (similar structure) -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editRoleId" /> <!-- Optional: if you have real ID -->
                <div class="mb-3">
                    <label class="form-label">Role Name <span class="text-danger">*</span></label>
                    <input type="text" id="editRoleName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Role Description <span class="text-danger">*</span></label>
                    <input type="text" id="editRoleDesc" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select id="editRoleStatus" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateRole()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables + Bootstrap 5 scripts -->
    @* <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>

    <!-- MISSING ONE -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>

    <!-- For Excel (optional but recommended) -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script> *@

    <script>
        let dt;

        function BuildActionsHtml() 
        {
        return `<div class="action-icons">
        <button class="act-btn act-view" title="View"><i class="fas fa-eye"></i></button>
        <button class="act-btn act-edit" title="Edit"><i class="fas fa-pen"></i></button>
        <button class="act-btn act-delete" title="Delete"><i class="fas fa-trash-alt"></i></button>
        </div>`;
        }

        $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#rolesTable')) {
        $('#rolesTable').DataTable().destroy();
        }

        dt = $('#rolesTable').DataTable({
        dom: "<'row mb-2'<'col-sm-3'l><'col-sm-5 text-center'B><'col-sm-4'f>>" +
        "<'row'<'col-sm-12'tr>>" +
        "<'row mt-2'<'col-sm-5'i><'col-sm-7'p>>",
        buttons: [
        { extend: 'colvis', text: 'Columns', className: 'btn btn-light btn-sm' },
        { extend: 'excel', text: 'Export', className: 'btn btn-light btn-sm' }
        ],
        pageLength: 10,
        order: [[2, 'asc']],
        columnDefs: [{ orderable: false, targets: [0, 1] }],
        language: { search: "Search:" }
        });

        // Delegated event handlers (This is the most important fix!)
        $('#rolesTable tbody').on('click', '.act-edit', function () {
        openEditModal(this);
        });

        $('#rolesTable tbody').on('click', '.act-delete', function () {
        deleteRow(this);
        });

        // Check all
        $('#checkAll').on('change', function () {
        $('tbody input[type="checkbox"]').prop('checked', this.checked);
        });
        });

        /* ==================== Status Filter ==================== */
        function filterByStatus(status) {
        if (dt.column(4).search() === status) {
        dt.column(4).search('').draw();
        } else {
        dt.column(4).search(status).draw();
        }
        }

        /* ==================== Create Role ==================== */
        function openCreateModal() {
        $('#newRoleName, #newRoleDesc').val('');
        $('#newRoleStatus').val('Active');
        new bootstrap.Modal(document.getElementById('createRoleModal')).show();
        }

        function saveRole() {
        const roleName = $("#newRoleName").val().trim();
        const roleDesc = $("#newRoleDesc").val().trim();
        const status = $("#newRoleStatus").val();

        if (!roleName || !roleDesc) {
        alert("Role Name and Description are required");
        return;
        }

        $.ajax({
        url: '/Administration/CreateRole',
        type: 'POST',
        data: { roleName, roleDesc, status },
        success: function (res) {
        if (res.success) {
        const badge = status === 'Active'
        ? '<span class="badge badge-active text-white">Active</span>'
        : '<span class="badge badge-inactive text-white">Inactive</span>';

                 const newRow = dt.row.add([
            BuildActionsHtml(),
            '<input type="checkbox" />',
            roleName,
            roleDesc,
            badge
        ]).draw(false).node();

        // 🔥 THIS IS THE IMPORTANT LINE
        $(newRow).attr('data-id', res.id);

       

        bootstrap.Modal.getInstance(document.getElementById('createRoleModal')).hide();
        } else {
        alert(res.message || "Failed to create role");
        }
        },
        error: function () {
        alert("Server error occurred");
        }
        });
        }

        /* ==================== Edit Role ==================== */
        function openEditModal(btn) {
        const row = $(btn).closest('tr');
        const data = dt.row(row).data();

        const id = row.data('id'); // ✅ ADD THIS
        $('#editRoleId').val(id);  // ✅ IMPORTANT

        $('#editRoleName').val(data[2]);
        $('#editRoleDesc').val(data[3]);

        // Extract status text from badge
        const statusText = $(data[4]).text().trim();
        $('#editRoleStatus').val(statusText);

        new bootstrap.Modal(document.getElementById('editRoleModal')).show();

        // Store reference for update
        window.currentEditRow = dt.row(row);
        }

                function updateRole() {
            const name = $('#editRoleName').val().trim();
            const desc = $('#editRoleDesc').val().trim();
            const status = $('#editRoleStatus').val();
            const id = $('#editRoleId').val(); // IMPORTANT

            $.ajax({
                url: '/Administration/UpdateRole',
                type: 'POST',
                data: { id, roleName: name, roleDesc: desc, status },
                success: function (res) {
                    if (res.success) {
                        const badge = `<span class="badge ${status === 'Active' ? 'badge-active' : 'badge-inactive'} text-white">${status}</span>`;

                        window.currentEditRow.data([
                            BuildActionsHtml(),
                            '<input type="checkbox" />',
                            name,
                            desc,
                            badge
                        ]).draw(false);

                        bootstrap.Modal.getInstance(document.getElementById('editRoleModal')).hide();
                    }
                }
            });
        }

        /* ==================== Delete ==================== */
                function deleteRow(btn) {
            if (!confirm('Are you sure?')) return;

            const row = $(btn).closest('tr');
            const id = row.data('id'); // IMPORTANT

            $.ajax({
                url: '/Administration/DeleteRole',
                type: 'POST',
                data: { id },
                success: function (res) {
                    if (res.success) {
                        dt.row(row).remove().draw();
                    }
                }
            });
        }
    </script>
}